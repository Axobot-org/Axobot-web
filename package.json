{
  "name": "axobot-web",
  "version": "1.0.1",
  "type": "module",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@reduxjs/toolkit": "^2.2.3",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "compression": "^1.8.1",
    "discord-api-types": "^0.37.92",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "markdown-it": "^14.1.0",
    "morgan": "^1.10.1",
    "mui-color-input": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-infinite-scroll-hook": "^6.0.1",
    "react-number-format": "^5.4.0",
    "react-redux": "9.2",
    "react-router": "^7.9.4",
    "sirv": "^3.0.2",
    "typescript": "^5.9.3",
    "typia": "^9.7.2",
    "vite": "^7.1.12",
    "vite-plugin-svgr": "4.5",
    "vite-tsconfig-paths": "^5.1.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "npm run build && NODE_ENV=production node server",
    "dev": "node server",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --ssrManifest --outDir build/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir build/server",
    "build-checks": "npx typia generate --input src/repository/types/checks/templates --output src/repository/types/checks/generated --project tsconfig.json",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "2.0.1",
    "semver": "7.5.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/express": "^5.0.4",
    "@types/jest": "^27.5.2",
    "@types/markdown-it": "^14.1.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.25",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "8.46",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "typescript-eslint": "^8.11.0"
  }
}